{
  "name": "storybook-addon-tag-editor",
  "version": "0.1.0",
  "description": "Edit story and component tags from the Storybook sidebar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidnioulz/storybook-addon-tag-editor.git"
  },
  "keywords": [
    "storybook",
    "storybook-addon",
    "tags",
    "organize"
  ],
  "license": "MIT",
  "author": "Steve Dodier-Lazaro <sidnioulz@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./preset": "./dist/preset.js",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build-storybook": "storybook build",
    "build:watch": "npm run build -- --watch",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "start": "run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p ${PORT:-6006}",
    "test": "vitest run",
    "release": "pnpm build && pnpm semantic-release",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "chromatic": "chromatic"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@storybook/addon-docs": "https://pkg.pr.new/@storybook/addon-docs@aa7e796",
    "@storybook/addon-vitest": "https://pkg.pr.new/@storybook/addon-vitest@aa7e796",
    "@storybook/icons": "^2.1.0",
    "@storybook/react-vite": "https://pkg.pr.new/@storybook/react-vite@aa7e796",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-istanbul": "^5.0.2",
    "chromatic": "^18.10.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "next",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "playwright": "latest",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "storybook": "https://pkg.pr.new/storybook@aa7e796",
    "ts-dedent": "^2.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "storybook": "^11.0.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/index.ts",
      "src/preview.ts"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "storybook": {
    "displayName": "Tag Editor",
    "supportedFrameworks": [
      "supported-frameworks"
    ],
    "icon": "https://raw.githubusercontent.com/Sidnioulz/storybook-addon-tag-editor/main/static/icon.png"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "dependencies": {
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
